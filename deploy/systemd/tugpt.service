# deploy/systemd/tugpt.service
#
# Supervises the TuGPT Docker Compose stack on the VPS so it starts on
# boot and restarts if the host reboots unexpectedly. Docker Compose
# itself (restart: unless-stopped, per service) handles restarting
# individual containers that crash — this unit only owns the stack as a
# whole.
#
# Install (as root, on the VPS):
#   cp deploy/systemd/tugpt.service /etc/systemd/system/tugpt.service
#   systemctl daemon-reload
#   systemctl enable --now tugpt.service
#
# Operate:
#   systemctl status tugpt        # stack status
#   systemctl restart tugpt       # recreate containers
#   journalctl -u tugpt -f        # follow compose output
#
# See docs/production_environment.md (section 5) for the full runbook,
# including the expected working directory layout and /etc/tugpt/*.env
# files this depends on.
#
# DO NOT ENABLE THIS UNIT YET (as of 2026-08-20).
#
# It brings up the WHOLE compose file, which includes whatsapp-worker and
# draft-worker. Those are the same jobs tugpt-whatsapp-worker.service and
# tugpt-draft-worker.service run natively on the host right now, so enabling
# this while they are active puts two consumers on each PGMQ queue and
# double-processes every message. The web app was authorized to move onto the
# VPS on 2026-08-20; the workers were not.
#
# To run the web app alone, use deploy/systemd/tugpt-web.service — see section
# 5.4a of the runbook. This unit is for the worker cutover in section 5.4,
# which stops and disables the native units in the same sequence. The two units
# declare Conflicts= on each other so they cannot both be active.

[Unit]
Description=TuGPT.ai Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Conflicts=tugpt-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tugpt
# Supplies NEXT_PUBLIC_* for Compose build-arg interpolation; docker-compose.yml
# declares them with `:?` so a missing value fails the unit instead of baking an
# empty string into the web image.
EnvironmentFile=/etc/tugpt/web.env
ExecStart=/usr/bin/docker compose -p tugpt -f /opt/tugpt/docker-compose.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -p tugpt -f /opt/tugpt/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
