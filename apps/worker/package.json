    "@tugpt/database": "workspace:*",
    "@tugpt/jobs": "workspace:*",
    "@tugpt/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}