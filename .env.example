# Anymize AI Integration (tertiary fallback provider, server-side only)
# Default endpoint: https://app.anymize.ai/api/v1/llm (official Anymize API base)
# ANYMIZE_DEFAULT_MODEL must be set to a valid model identifier when enabled.
# Use GET /models to discover available models from the account.
ANYMIZE_API_KEY=
ANYMIZE_ENDPOINT_URL=https://app.anymize.ai/api/v1/llm
ANYMIZE_DEFAULT_MODEL=

# Draft Worker Configuration
DRAFT_WORKER_POLL_INTERVAL_MS=5000
DRAFT_WORKER_VISIBILITY_TIMEOUT_SECONDS=30

# Worker Configuration
WORKER_POLL_INTERVAL_MS=5000
WORKER_VISIBILITY_TIMEOUT_SECONDS=30
WORKER_MAX_ATTEMPTS=5