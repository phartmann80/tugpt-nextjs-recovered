# ─────────────────────────────────────────────────────────────
# TuGPT Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# All other variables are server-only and must never be imported client-side.

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Providers (Draft Generation) ────────────────────────────
# The DraftOrchestrator uses a three-provider failover chain:
#   Logicc (primary) → Langdock (secondary) → Anymize (tertiary)
# If a provider's required variables are missing, it is skipped
# with a warning. At least one provider must be configured.

# Logicc — Primary draft provider
LOGICC_API_KEY=your-logicc-api-key
LOGICC_ENDPOINT_URL=https://api.logicc.com/v1
LOGICC_DEFAULT_MODEL=logicc-default

# Langdock — Secondary failover provider
LANGDOCK_API_CODE=your-langdock-api-code
LANGDOCK_ENDPOINT_URL=https://api.langdock.com/v1
MODEL=langdock-default-model

# Anymize — Tertiary fallback provider
ANYMIZE_API_KEY=your-anymize-api-key
ANYMIZE_ENDPOINT_URL=https://app.anymize.ai/api/v1/llm
ANYMIZE_DEFAULT_MODEL=anymize-default

# ── Mastra Orchestrator ───────────────────────────────────────
GATEWAY_API_MASTER_KEY=your-gateway-master-key
GATEWAY_API_URL=https://gateway.mastra.ai

# ── IonOS AI Assistant ────────────────────────────────────────
IONOS_API_KEY=your-ionos-api-key

# ── HubSpot CRM ───────────────────────────────────────────────
HUBSPOT_API_KEY=your-hubspot-api-key